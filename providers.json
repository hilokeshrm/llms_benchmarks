{
  "_comment": [
    "Provider endpoints and per-model routing for run_api_quality.py.",
    "Every model_key maps to an ordered list of candidates; the runner uses the first",
    "candidate whose provider has an API key present in the environment.",
    "MODEL ID STRINGS ARE UNVERIFIED. Providers rename and retire them constantly.",
    "Run `python run_api_quality.py --check` to resolve every id against each",
    "provider's /models endpoint before starting a campaign."
  ],
  "providers": {
    "groq": {
      "base_url": "https://api.groq.com/openai/v1",
      "env": "GROQ_API_KEY",
      "rpm": 30,
      "signup": "https://console.groq.com"
    },
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "env": "OPENROUTER_API_KEY",
      "rpm": 20,
      "signup": "https://openrouter.ai/keys"
    },
    "nvidia": {
      "base_url": "https://integrate.api.nvidia.com/v1",
      "env": "NVIDIA_API_KEY",
      "rpm": 40,
      "signup": "https://build.nvidia.com"
    },
    "cerebras": {
      "base_url": "https://api.cerebras.ai/v1",
      "env": "CEREBRAS_API_KEY",
      "rpm": 30,
      "signup": "https://cloud.cerebras.ai"
    },
    "mistral": {
      "base_url": "https://api.mistral.ai/v1",
      "env": "MISTRAL_API_KEY",
      "rpm": 60,
      "signup": "https://console.mistral.ai"
    },
    "cohere": {
      "base_url": "https://api.cohere.ai/compatibility/v1",
      "env": "COHERE_API_KEY",
      "rpm": 20,
      "signup": "https://dashboard.cohere.com/api-keys"
    },
    "huggingface": {
      "base_url": "https://router.huggingface.co/v1",
      "env": "HF_TOKEN",
      "rpm": 30,
      "signup": "https://huggingface.co/settings/tokens"
    },
    "together": {
      "base_url": "https://api.together.xyz/v1",
      "env": "TOGETHER_API_KEY",
      "rpm": 60,
      "signup": "https://api.together.xyz/settings/api-keys"
    },
    "fireworks": {
      "base_url": "https://api.fireworks.ai/inference/v1",
      "env": "FIREWORKS_API_KEY",
      "rpm": 60,
      "signup": "https://fireworks.ai/account/api-keys"
    },
    "deepinfra": {
      "base_url": "https://api.deepinfra.com/v1/openai",
      "env": "DEEPINFRA_API_KEY",
      "rpm": 60,
      "signup": "https://deepinfra.com/dash/api_keys"
    },
    "sambanova": {
      "base_url": "https://api.sambanova.ai/v1",
      "env": "SAMBANOVA_API_KEY",
      "rpm": 30,
      "signup": "https://cloud.sambanova.ai/apis"
    }
  },
  "models": {
