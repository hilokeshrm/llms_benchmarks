# Copy to .env and paste your keys after the '='. .env is gitignored.
# Never commit a key. Never paste one into a chat window.
#
#   cp .env.example .env
#   python run_api_quality.py --list-providers
#   python run_api_quality.py --check

# ---------------------------------------------------------------------------
# REQUIRED - these three cover all 25 models in the registry
# ---------------------------------------------------------------------------

# 17 models. Broadest single key. Sole source for: glm-4.5, minimax-m1
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 9 models. Sole source for: olmo-2-32b, falcon3-10b, exaone-4-32b,
# sarvam-m, sea-lion-v3, internlm3-8b
# https://huggingface.co/settings/tokens   (a read-scope token is enough)
HF_TOKEN=

# 12 models. Sole source for: nemotron-mini-4b. Also the only host of
# nemotron-super-49b, which Ollama cannot run at all.
# https://build.nvidia.com
NVIDIA_API_KEY=

# ---------------------------------------------------------------------------
# RECOMMENDED - adds no coverage, but much faster with generous free limits,
# which cuts wall-clock time on a full sweep
# ---------------------------------------------------------------------------

# 6 models: llama-3.3-70b, llama-4-scout, gpt-oss-120b, qwen3-32b,
# deepseek-r1 (distill), kimi-k2
# https://console.groq.com
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL - first-party endpoints and extra fallbacks. Only worth adding if a
# required provider is rate-limiting you or has dropped a model.
# ---------------------------------------------------------------------------

# 4 models: llama-3.3-70b, gpt-oss-120b, qwen3-32b, qwen3-235b-a22b
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# 2 models, first-party: mistral-small-3, mixtral-8x22b
# https://console.mistral.ai
MISTRAL_API_KEY=

# 1 model, first-party: aya-expanse-32b
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# 4 models: llama-3.3-70b, mistral-small-3, mixtral-8x22b, deepseek-v3
# https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# 3 models: gemma-3-27b, phi-4, nemotron-70b
# https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# Endpoints are defined in providers.json but no models route to them yet.
# Add entries under "models" in providers.json if you want to use these.
FIREWORKS_API_KEY=
SAMBANOVA_API_KEY=
